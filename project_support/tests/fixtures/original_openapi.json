  "components": {
    "schemas": {
      "DeviceAction": {
        "properties": {
          "device_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Device Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "connect",
              "disconnect",
              "sync",
              "loopback"
            ],
            "title": "Action"
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "action"
        ],
        "title": "DeviceAction"
      },
      "FaultRequest": {
        "properties": {
          "target": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Target"
          },
          "kind": {
            "type": "string",
            "enum": [
              "link_loss",
              "power_drop",
              "thermal_spike",
              "storage_pressure",
              "latency_spike"
            ],
            "title": "Kind"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Severity",
            "default": "medium"
          },
          "duration_seconds": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Duration Seconds",
            "default": 60
          }
        },
        "type": "object",
        "required": [
          "target",
          "kind"
        ],
        "title": "FaultRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HilSequenceRequest": {
        "properties": {
          "sequence_id": {
            "type": "string",
            "enum": [
              "preflight",
              "closed_loop",
              "fault_recovery"
            ],
            "title": "Sequence Id",
            "default": "closed_loop"
          }
        },
        "type": "object",
        "title": "HilSequenceRequest"
      },
      "LinkBudgetRequest": {
        "properties": {
          "link_id": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Link Id"
          },
          "frequency_ghz": {
            "type": "number",
            "maximum": 300.0,
            "exclusiveMinimum": 0.1,
            "title": "Frequency Ghz",
            "default": 26.0
          },
          "distance_km": {
            "type": "number",
            "maximum": 100000.0,
            "exclusiveMinimum": 1.0,
            "title": "Distance Km",
            "default": 1200.0
          },
          "tx_power_w": {
            "type": "number",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.01,
            "title": "Tx Power W",
            "default": 20.0
          },
          "tx_gain_dbi": {
            "type": "number",
            "maximum": 100.0,
            "minimum": -20.0,
            "title": "Tx Gain Dbi",
            "default": 32.0
          },
          "rx_gain_dbi": {
            "type": "number",
            "maximum": 100.0,
            "minimum": -20.0,
            "title": "Rx Gain Dbi",
            "default": 34.0
          },
          "misc_losses_db": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Misc Losses Db",
            "default": 3.0
          },
          "bandwidth_mhz": {
            "type": "number",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.001,
            "title": "Bandwidth Mhz",
            "default": 20.0
          },
          "data_rate_mbps": {
            "type": "number",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.001,
            "title": "Data Rate Mbps",
            "default": 10.0
          },
          "system_temp_k": {
            "type": "number",
            "maximum": 5000.0,
            "exclusiveMinimum": 1.0,
            "title": "System Temp K",
            "default": 290.0
          },
          "required_ebno_db": {
            "type": "number",
            "maximum": 50.0,
            "minimum": -10.0,
            "title": "Required Ebno Db",
            "default": 7.0
          }
        },
        "type": "object",
        "required": [
          "link_id"
        ],
        "title": "LinkBudgetRequest"
      },
      "MissionAction": {
        "properties": {
          "mission_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Mission Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "start",
              "pause",
              "replan",
              "abort",
              "complete"
            ],
            "title": "Action"
          }
        },
        "type": "object",
        "required": [
          "mission_id",
          "action"
        ],
        "title": "MissionAction"
      },
      "MissionReplanRequest": {
        "properties": {
          "mission_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Mission Id"
